<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Sign in with Apple needs a paid Apple Developer Program membership to be
	  provisioned. Without one this entitlement cannot be signed, so the build
	  settings leave CODE_SIGN_ENTITLEMENTS unset by default and AuthController
	  falls through to its local stub. Point CODE_SIGN_ENTITLEMENTS at this file
	  once an account is available.
	-->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
